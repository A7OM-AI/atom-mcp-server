# ============================================================
# Attic Standard MCP Server — Environment variables
# ============================================================
# Set these in the host's environment (Railway), never in the repo.

SUPABASE_URL=https://your-project.supabase.co
# Server-side key. Stays in the host environment only.
SUPABASE_SERVICE_ROLE_KEY=your_server_side_key_here

# Transport: "stdio" (default) or "http"
TRANSPORT=stdio

# Port for HTTP transport (default 3000)
PORT=3000
